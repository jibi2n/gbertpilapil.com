---
// One project in a grid. The whole card opens the project's detail panel, so
// the page also needs <ProjectPanels> for the same projects.
import type { Project } from '../lib/models/Project';
import TechLogo from './TechLogo.astro';

interface Props {
  project: Project;
  /** Picture, title and summary only. The tech list and links stay in the panel. */
  minimal?: boolean;
}

const { project, minimal = false } = Astro.props;
---

<article class="project" data-spec={project.specializations.join('|')} data-tech={project.technologies.join('|')}>
  {
    project.imageUrl ? (
      <div class="media is-pending">
        <img src={project.imageUrl} alt="" width="1280" height="800" loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="media cover">
        <span class="display">{project.title}</span>
      </div>
    )
  }
  {
    !minimal && (
      <ul class="project-tech small" aria-label="Built with">
        {project.technologies.map((name) => (
          <li>
            <TechLogo name={name} />
            {name}
          </li>
        ))}
      </ul>
    )
  }
  <h3 class="subheading project-title">
    {/* This button's clickable area is stretched over the whole card (see .card-hit in global.css). */}
    <button type="button" class="card-hit" data-project-open={project.slug} aria-haspopup="dialog">
      {project.title}
    </button>
  </h3>
  <p class="project-summary">{project.summary}</p>
  {
    !minimal && (project.liveUrl || project.repoUrl) && (
      <p class="project-links">
        {project.liveUrl && <a class="link" href={project.liveUrl}>Visit the live site</a>}
        {project.repoUrl && <a class="link" href={project.repoUrl}>View the code</a>}
      </p>
    )
  }
</article>
