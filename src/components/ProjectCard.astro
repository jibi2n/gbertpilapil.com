---
// One project in a grid. Used on the home page and on the Projects page.
// The picture, the title and "Read what I did" all open the project's detail
// panel, so the page also needs <ProjectPanels> for the same projects.
import type { Project } from '../lib/models/Project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project" data-tech={project.technologies.join('|')}>
  {
    project.imageUrl ? (
      <button type="button" class="media is-pending" data-project-open={project.slug} tabindex="-1" aria-hidden="true">
        <img src={project.imageUrl} alt="" width="1280" height="800" loading="lazy" decoding="async" />
      </button>
    ) : (
      <button type="button" class="media cover" data-project-open={project.slug} tabindex="-1" aria-hidden="true">
        <span class="display">{project.title}</span>
      </button>
    )
  }
  <ul class="project-tech small" aria-label="Built with">
    {project.technologies.map((name) => <li>{name}</li>)}
  </ul>
  <h3 class="subheading project-title">
    <button type="button" data-project-open={project.slug} aria-haspopup="dialog">
      {project.title}
    </button>
  </h3>
  <p class="prose mt-3">{project.summary}</p>
  <p class="project-links">
    <button type="button" class="link" data-project-open={project.slug} aria-haspopup="dialog">
      Read what I did
    </button>
    {project.liveUrl && <a class="link" href={project.liveUrl}>Visit the live site</a>}
    {project.repoUrl && <a class="link" href={project.repoUrl}>View the code</a>}
  </p>
</article>
