---
import { EXPERIENCE_KINDS, type Experience, type ExperienceKind } from '../lib/models/Experience';

interface Props {
  experiences: Experience[];
  emptyMessage: string;
}

const { experiences, emptyMessage } = Astro.props;

// Roles first, then Education, then Awards and activities, each under its own heading.
const groups = (Object.keys(EXPERIENCE_KINDS) as ExperienceKind[])
  .map((kind) => ({ kind, heading: EXPERIENCE_KINDS[kind], entries: experiences.filter((entry) => entry.kind === kind) }))
  .filter((group) => group.entries.length > 0);
---

<section id="experience" class="section">
  <h2 class="display heading section-head" data-reveal>Experience</h2>
  {experiences.length === 0 && <p class="small">{emptyMessage}</p>}
  {
    groups.map((group) => (
      <>
        {/* The first group needs no label: the section heading already says "Experience". */}
        {group.kind !== 'experience' && (
          <h3 class="subheading xp-group" data-reveal>
            {group.heading}
          </h3>
        )}
        <ol data-reveal-group>
          {group.entries.map((entry) => (
            <li class="xp grid-12" data-collapsible>
              <p class="xp-period small">{entry.period()}</p>
              <div class="xp-role">
                <h3 class="subheading">{entry.role}</h3>
                <p class="mt-1">{entry.organization}</p>
              </div>
              {/* On phones the description and all but three skills fold away behind the arrow. */}
              <div class="xp-desc">
                <p class="prose xp-text">{entry.description}</p>
                {entry.skills.length > 0 && (
                  <ul class="tags" aria-label="Skills used">
                    {entry.skills.map((skill) => (
                      <li class="tag">{skill}</li>
                    ))}
                    {entry.skills.length > 3 && (
                      <li class="tag tag-more" aria-hidden="true">
                        +{entry.skills.length - 3}
                      </li>
                    )}
                  </ul>
                )}
                {(entry.description || entry.skills.length > 3) && (
                  <button type="button" class="xp-toggle" data-toggle aria-expanded="false" aria-label={`Details: ${entry.role}`}>
                    <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </button>
                )}
              </div>
            </li>
          ))}
        </ol>
      </>
    ))
  }
</section>
