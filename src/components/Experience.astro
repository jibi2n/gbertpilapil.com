---
import type { Experience } from '../lib/models/Experience';

interface Props {
  experiences: Experience[];
  emptyMessage: string;
}

const { experiences, emptyMessage } = Astro.props;
---

<section id="experience" class="section">
  <h2 class="display heading section-head" data-reveal>Experience</h2>
  {experiences.length === 0 && <p class="small">{emptyMessage}</p>}
  <ol data-reveal-group>
    {
      experiences.map((experience) => (
        <li class="xp grid-12">
          <p class="xp-period small">{experience.period()}</p>
          <div class="xp-role">
            <h3 class="subheading">{experience.role}</h3>
            <p class="mt-1">{experience.organization}</p>
          </div>
          <p class="xp-desc prose">{experience.description}</p>
        </li>
      ))
    }
  </ol>
</section>
