---
import { site } from '../site';

// Links start with "/" so they also work from the resume page.
---

<header class="nav">
  <a href="/" class="nav-name" data-home>{site.name}</a>
  <nav class="nav-links" aria-label="Sections">
    {site.sections.map((section) => <a href={`/#${section.id}`}>{section.label}</a>)}
  </nav>
  <button type="button" class="mode-toggle" aria-label="Switch to dark mode">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <mask id="moon-mask">
        <rect x="-6" y="-6" width="36" height="36" fill="white"></rect>
        <circle class="moon-bite" cx="26" cy="6" r="5" fill="black"></circle>
      </mask>
      <circle class="sun-core" cx="12" cy="12" r="4.5" mask="url(#moon-mask)"></circle>
      <g class="sun-rays">
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </g>
    </svg>
  </button>
  <a href="/resume" class="nav-resume">Resume</a>
  <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
</header>

<nav id="menu" class="menu display" aria-label="Sections" hidden>
  {site.sections.map((section) => <a href={`/#${section.id}`}>{section.label}</a>)}
</nav>
