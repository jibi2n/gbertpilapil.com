---
import { site } from '../site';
import ThemeSlider from './ThemeSlider.astro';
---

<header class="nav">
  <a href="#top" class="nav-name">{site.name}</a>
  <ThemeSlider />
  <nav class="nav-links" aria-label="Sections">
    {site.sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
  </nav>
  <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
</header>

<nav id="menu" class="menu display" aria-label="Sections" hidden>
  {site.sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
</nav>
