---
// The landing view, shown instead of the full site while the "summary" theme
// is active: a business card that flips over. The front says who I am and how
// to reach me; the back has my top projects and my stack.
import type { Project } from '../lib/models/Project';
import type { Technology } from '../lib/models/Technology';
import { techColor, techIcon } from '../lib/techIcons';
import { site } from '../site';
import Icon from './Icon.astro';

interface Props {
  /** The showcased projects. The first three go on the back. */
  projects: Project[];
  /** Technologies grouped by category. */
  stack: Map<string, Technology[]>;
}

const { projects, stack } = Astro.props;
const top = projects.slice(0, 3);
// The card only has room for logos, so technologies without one are left off.
const logos = [...stack.values()]
  .flat()
  .map((technology) => ({ name: technology.name, path: techIcon(technology.name), color: techColor(technology.name) }))
  .filter((logo): logo is { name: string; path: string; color: string } => logo.path !== null);

const linkIcon = (label: string) => label.toLowerCase() as 'linkedin' | 'github' | 'facebook' | 'instagram';
---

<section class="summary" aria-label="Business card">
  <div class="card" data-card>
    <div class="card-face card-front">
      <svg class="card-flip-hint" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5" />
      </svg>

      <div class="card-who">
        <h1 class="display card-name">{site.name}</h1>
        <p class="card-title">Full-Stack Developer</p>
        <p class="card-school">4th Year BS Computer Science<br />University of Santo Tomas</p>
      </div>

      <ul class="card-contact" aria-label="Contact">
        <li>
          <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
        </li>
        {
          site.phone && (
            <li>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" />{site.phone}</a>
            </li>
          )
        }
        <li class="card-socials">
          {
            site.links.map((link) => (
              <a href={link.href} aria-label={link.label} title={link.label}>
                <Icon name={linkIcon(link.label)} />
              </a>
            ))
          }
        </li>
      </ul>
    </div>

    <div class="card-face card-back" inert>
      <div>
        <h2 class="card-label">Projects I'm proud of</h2>
        <ul class="card-projects">
          {
            top.map((project) => (
              <li>
                {project.primaryUrl ? (
                  <a href={project.primaryUrl}>
                    {project.title}
                    <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                  </a>
                ) : (
                  <span>{project.title}</span>
                )}
                <ul class="card-chips" aria-label="Built with">
                  {project.technologies.slice(0, 3).map((name) => <li class="card-chip">{name}</li>)}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="card-label">Stack</h2>
        <ul class="card-logos">
          {
            logos.map(({ name, path, color }) => (
              <li title={name} style={`--logo: ${color}`}>
                <svg class="icon icon-fill" viewBox="0 0 24 24" role="img" aria-label={name}>
                  <path d={path} />
                </svg>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <p class="summary-actions">
    <button type="button" class="button button-quiet" data-card-flip aria-pressed="false">Flip card</button>
    <button type="button" class="button" data-set-theme="professional">View my full portfolio</button>
  </p>
</section>
