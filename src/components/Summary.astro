---
// The landing view for hiring managers, shown instead of the full site while
// the "summary" theme is active.
//
// Laid out for quick scanning: one narrow column so lines stay short, a clear
// order (who I am, how to reach me, projects, experience, education, awards,
// skills), one heading size per level, and nothing that moves. No mascot, no
// theme picker, no intro animation.
import { EXPERIENCE_KINDS, type Experience, type ExperienceKind } from '../lib/models/Experience';
import type { Project } from '../lib/models/Project';
import type { Technology } from '../lib/models/Technology';
import { site } from '../site';
import Entry from './Entry.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  /** The showcased projects, the same ones the portfolio shows. */
  projects: Project[];
  /** How many more are on the Projects page. */
  moreCount: number;
  experiences: Experience[];
  /** Technologies grouped by category. */
  stack: Map<string, Technology[]>;
}

const { projects, moreCount, experiences, stack } = Astro.props;

// Experience, Education, and Awards and activities, each as its own section.
const sections = (Object.keys(EXPERIENCE_KINDS) as ExperienceKind[])
  .map((kind) => ({ kind, heading: EXPERIENCE_KINDS[kind], entries: experiences.filter((entry) => entry.kind === kind) }))
  .filter((section) => section.entries.length > 0);

/** Which icon goes with a contact link, by its label. */
const linkIcon = (label: string) => (label.toLowerCase() === 'github' ? 'github' : 'linkedin');
---

<section class="summary" aria-label="Summary">
  <div class="summary-wrap">
    <header>
      <p class="summary-hi">Hi, I'm</p>
      <h1 class="display summary-name">{site.name}</h1>
      <p class="summary-lede">{site.summary}</p>

      <ul class="contact-row" aria-label="Contact">
        <li>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" />
            {site.email}
          </a>
        </li>
        {
          site.links.slice(0, 2).map((link) => (
            <li>
              <a href={link.href}>
                <Icon name={linkIcon(link.label)} />
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="contact-plain">
          <Icon name="pin" />
          {site.location}
        </li>
      </ul>

      <p class="summary-actions">
        <a class="button" href="/resume.pdf" download="Gbert-Pilapil-Resume.pdf">Download resume (PDF)</a>
        <button type="button" class="button button-quiet" data-set-theme="professional">See the full portfolio</button>
      </p>
    </header>

    <section class="summary-block" aria-labelledby="summary-projects">
      <h2 class="display heading" id="summary-projects">Projects</h2>
      <div class="projects">
        {projects.map((project) => <ProjectCard project={project} minimal />)}
      </div>
      {
        moreCount > 0 && (
          <p class="projects-more">
            <a class="button button-quiet" href="/projects">
              View more projects
            </a>
          </p>
        )
      }
    </section>

    {
      sections.map((section) => (
        <section class="summary-block" aria-labelledby={`summary-${section.kind}`}>
          <h2 class="display heading" id={`summary-${section.kind}`}>
            {section.heading}
          </h2>
          {section.entries.map((entry) => (
            <Entry entry={entry} />
          ))}
        </section>
      ))
    }

    <section class="summary-block" aria-labelledby="summary-skills">
      <h2 class="display heading" id="summary-skills">Skills</h2>
      <dl class="skill-rows">
        {
          [...stack].map(([category, technologies]) => (
            <div class="skill-row">
              <dt>{category}</dt>
              <dd>{technologies.map((technology) => technology.name).join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</section>
