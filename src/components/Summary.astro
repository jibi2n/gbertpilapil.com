---
// The landing view, shown instead of the full site while the "summary" theme
// is active: a business card that flips over. The front says who I am and how
// to reach me; the back has my top projects and my core stack.
import type { Project } from '../lib/models/Project';
import { techColor, techIcon } from '../lib/techIcons';
import { site } from '../site';
import Icon from './Icon.astro';

interface Props {
  /** The showcased projects. The first three go on the back. */
  projects: Project[];
  /** How many technologies there are in all, for the "+ more" line. */
  techCount: number;
}

const { projects, techCount } = Astro.props;
const { stack } = site.card;
// Small cards show six, so they have more left over.
const moreWide = techCount - stack.length;
const moreNarrow = techCount - Math.min(stack.length, 6);
const top = projects.slice(0, 3);

const linkIcon = (label: string) => label.toLowerCase() as 'linkedin' | 'github' | 'facebook' | 'instagram';
---

<section class="summary" aria-label="Business card">
  <div class="card" data-card>
    <div class="card-inner">
      <div class="card-face card-front">
        {/* Faint circuit traces in the top right corner, fading out toward the middle. */}
        <svg class="card-circuit" viewBox="0 0 240 160" aria-hidden="true">
          <defs>
            <pattern id="card-grid" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M12 0H0V12" fill="none" stroke="currentColor" stroke-width="0.4" />
            </pattern>
            <radialGradient id="card-fade" cx="1" cy="0" r="1">
              <stop offset="0" stop-color="#fff" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </radialGradient>
            <mask id="card-circuit-mask">
              <rect width="240" height="160" fill="url(#card-fade)" />
            </mask>
          </defs>
          <g mask="url(#card-circuit-mask)" fill="none" stroke="currentColor" stroke-width="1">
            <rect width="240" height="160" fill="url(#card-grid)" stroke="none" />
            <path d="M240 22h-62l-16 16h-46M240 48h-44l-14 14h-34l-14 14M240 74h-36l-14 14h-26M240 104h-26l-14 14v22M196 0v14l16 16h28M150 0v18l14 14M120 0v8l-12 12h-30" />
            <circle cx="116" cy="38" r="2.5" />
            <circle cx="114" cy="76" r="2.5" />
            <circle cx="164" cy="88" r="2.5" />
            <circle cx="200" cy="140" r="2.5" />
            <circle cx="164" cy="32" r="2.5" />
            <circle cx="78" cy="20" r="2.5" />
          </g>
        </svg>

        <p class="card-pitch">{site.card.pitch}</p>

        <div class="card-bottom">
          <div>
            <h1 class="display card-name">{site.name}</h1>
            <p class="card-title">{site.card.title}</p>
            <p class="card-school">{site.card.school}</p>
            <p class="card-school card-location"><Icon name="pin" />{site.location}</p>
          </div>

          <div class="card-contact">
            <p class="card-email">
              <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
              <button type="button" class="card-copy" data-copy={site.email} aria-label="Copy email address">
                <Icon name="copy" />
                <span class="copied-label" aria-hidden="true">Copied</span>
              </button>
            </p>
            {
              site.phone && (
                <p>
                  <a href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" />{site.phone}</a>
                </p>
              )
            }
            <ul class="card-socials" aria-label="Elsewhere">
              {
                site.links.map((link) => (
                  <li>
                    <a href={link.href} aria-label={link.label} title={link.label}>
                      <Icon name={linkIcon(link.label)} />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="card-face card-back" inert>
        <div>
          <h2 class="card-label">Projects I'm proud of</h2>
          <ul class="card-projects">
            {
              top.map((project) => (
                <li>
                  {project.primaryUrl ? (
                    <a href={project.primaryUrl}>
                      {project.title}
                      <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                    </a>
                  ) : (
                    <span>{project.title}</span>
                  )}
                  <p class="card-project-summary">{project.summary}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="card-label">Core stack</h2>
          <ul class="card-stack">
            {
              stack.map((name) => {
                const path = techIcon(name);
                return (
                  <li style={`--logo: ${techColor(name) ?? 'currentColor'}`}>
                    {path && (
                      <svg class="icon icon-fill" viewBox="0 0 24 24" aria-hidden="true">
                        <path d={path} />
                      </svg>
                    )}
                    {name}
                  </li>
                );
              })
            }
            {
              moreNarrow > 0 && (
                <li class="card-stack-more">
                  {moreWide > 0 && <span class="card-more-wide">+{moreWide} more</span>}
                  <span class="card-more-narrow">+{moreNarrow} more</span>
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- The card itself flips on click; this is the keyboard way in and the hint. -->
  <button type="button" class="card-hint" data-card-flip aria-pressed="false">
    <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M14 4.1 12 6M5.1 8l-2.9-.8M6 12l-1.9 2M7.2 2.2 8 5.1M9.04 9.69a.5.5 0 0 1 .65-.65l11 4.5a.5.5 0 0 1-.07.95l-4.35 1.04a1 1 0 0 0-.74.74l-1.04 4.35a.5.5 0 0 1-.95.07z" />
    </svg>
    <span class="card-hint-front">Tap the card to see my projects</span>
    <span class="card-hint-back">Tap again to flip back</span>
  </button>

  <p class="summary-actions">
    <button type="button" class="button" data-set-theme="professional">View my full portfolio</button>
  </p>

</section>
