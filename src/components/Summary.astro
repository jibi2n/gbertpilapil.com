---
// The landing view: a plain, compact resume for hiring managers.
// Shown instead of the full site while the "summary" theme is active.
// Deliberately quiet: no animation, no mascot, no theme picker.
import type { Experience } from '../lib/models/Experience';
import type { Project } from '../lib/models/Project';
import type { Skill } from '../lib/models/Skill';
import type { Technology } from '../lib/models/Technology';
import { site } from '../site';

interface Props {
  /** The few projects worth leading with. */
  projects: Project[];
  experiences: Experience[];
  skills: Skill[];
  /** Technologies grouped by category. */
  stack: Map<string, Technology[]>;
}

const { projects, experiences, skills, stack } = Astro.props;
---

<section class="summary" aria-label="Resume summary">
  <div class="sheet">
    <header class="sheet-head">
      <div>
        <h1 class="sheet-name display">{site.name}</h1>
        <p class="sheet-headline">{site.headline}</p>
      </div>
      <ul class="sheet-contact">
        <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.links.slice(0, 2).map((link) => (
            <li>
              <a class="link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>{site.location}</li>
      </ul>
    </header>

    <p class="sheet-summary">{site.summary}</p>

    <p class="summary-actions">
      <a class="button" href="/resume.pdf" download="Gbert-Pilapil-Resume.pdf">Download resume (PDF)</a>
      <button type="button" class="link" data-set-theme="professional">See the full portfolio</button>
    </p>

    <div class="sheet-body">
      <div class="sheet-main">
        <section>
          <h2 class="sheet-label">Experience and education</h2>
          {
            experiences.map((entry) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>{entry.role}</h3>
                  <span class="entry-when">{entry.period()}</span>
                </div>
                <p class="entry-sub">{entry.organization}</p>
                {entry.description && <p class="entry-text">{entry.description}</p>}
              </article>
            ))
          }
        </section>

        <section>
          <h2 class="sheet-label">Projects</h2>
          {
            projects.map((project) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>
                    <button type="button" data-project-open={project.slug} aria-haspopup="dialog">
                      {project.title}
                    </button>
                  </h3>
                </div>
                <p class="entry-sub">{project.technologies.join(', ')}</p>
                <p class="entry-text">{project.summary}</p>
              </article>
            ))
          }
          <p class="entry">
            <a class="link" href="/projects">View all projects</a>
          </p>
        </section>
      </div>

      <aside class="sheet-side" aria-label="Skills">
        <section>
          <h2 class="sheet-label">Skills</h2>
          <dl class="sheet-skills">
            {
              [...stack].map(([category, technologies]) => (
                <div>
                  <dt>{category}</dt>
                  <dd>{technologies.map((technology) => technology.name).join(', ')}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section>
          <h2 class="sheet-label">Focus areas</h2>
          <ul class="sheet-focus">
            {skills.map((skill) => <li>{skill.name}</li>)}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</section>
