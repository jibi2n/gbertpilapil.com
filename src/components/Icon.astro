---
// Small line icons for contact details. They are decoration next to a text
// label, so they are hidden from screen readers.
import { siGithub } from 'simple-icons';

interface Props {
  name: 'mail' | 'linkedin' | 'github' | 'pin';
}

const { name } = Astro.props;
---

{
  name === 'github' ? (
    <svg class="icon icon-fill" viewBox="0 0 24 24" aria-hidden="true">
      <path d={siGithub.path} />
    </svg>
  ) : (
    <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true">
      {name === 'mail' && (
        <>
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </>
      )}
      {name === 'linkedin' && (
        <>
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect width="4" height="12" x="2" y="9" />
          <circle cx="4" cy="4" r="2" />
        </>
      )}
      {name === 'pin' && (
        <>
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
          <circle cx="12" cy="10" r="3" />
        </>
      )}
    </svg>
  )
}
