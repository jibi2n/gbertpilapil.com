---
// Small icons for contact details. They are hidden from screen readers, so the
// link they sit in needs a text label or an aria-label.
import { siFacebook, siGithub, siInstagram } from 'simple-icons';

interface Props {
  name: 'mail' | 'copy' | 'phone' | 'linkedin' | 'github' | 'facebook' | 'instagram';
}

const { name } = Astro.props;
const brands: Record<string, string> = { github: siGithub.path, facebook: siFacebook.path, instagram: siInstagram.path };
---

{
  brands[name] ? (
    <svg class="icon icon-fill" viewBox="0 0 24 24" aria-hidden="true">
      <path d={brands[name]} />
    </svg>
  ) : (
    <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true">
      {name === 'mail' && (
        <>
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </>
      )}
      {name === 'copy' && (
        <>
          <rect width="13" height="13" x="9" y="9" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </>
      )}
      {name === 'phone' && (
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      )}
      {name === 'linkedin' && (
        <>
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect width="4" height="12" x="2" y="9" />
          <circle cx="4" cy="4" r="2" />
        </>
      )}
    </svg>
  )
}
