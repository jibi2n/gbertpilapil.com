---
import type { Skill } from '../lib/models/Skill';

interface Props {
  skills: Skill[];
  emptyMessage: string;
}

const { skills, emptyMessage } = Astro.props;
---

<section id="skills" class="section">
  <h2 class="display heading section-head" data-reveal>What I do</h2>
  {skills.length === 0 && <p class="small">{emptyMessage}</p>}
  <ul class="skills" data-reveal-group>
    {
      skills.map((skill) => (
        <li class="skill" data-collapsible>
          <h3 class="subheading">
            {/* Phones get the button, which folds the description away; wider screens get the plain name. */}
            <span class="skill-name">{skill.name}</span>
            <button type="button" class="skill-toggle" data-toggle aria-expanded="false">
              {skill.name}
              <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
          </h3>
          <p>{skill.description}</p>
        </li>
      ))
    }
  </ul>
</section>
