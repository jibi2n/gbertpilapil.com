---
import { themes } from '../themes';

// 100 steps between neighbouring themes, so the disk drags smoothly and
// snaps to the nearest theme on release.
const max = (themes.length - 1) * 100;
---

<div class="theme-slider">
  <div class="theme-track" style={`--stops: ${themes.length}`}>
    {themes.map((_, i) => <span class="theme-tick" style={`--i: ${i}`} />)}
    <input
      id="theme-range"
      class="theme-range"
      type="range"
      min="0"
      max={max}
      value="0"
      aria-label="Site theme"
      aria-valuetext={themes[0].label}
      data-themes={JSON.stringify(themes)}
    />
  </div>
  <output class="theme-name" for="theme-range">{themes[0].label}</output>
</div>
