---
import type { Project } from '../lib/models/Project';
import ProjectCard from './ProjectCard.astro';

interface Props {
  /** The showcased projects. */
  projects: Project[];
  /** How many more are on the Projects page. The "View more" link shows when this is above zero. */
  moreCount: number;
  emptyMessage: string;
}

const { projects, moreCount, emptyMessage } = Astro.props;
---

<section id="projects" class="section">
  <h2 class="display heading section-head" data-reveal>Selected projects</h2>
  {projects.length === 0 && <p class="small">{emptyMessage}</p>}
  <div class="projects" data-reveal-group>
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
  {/* The Projects page is reached only from here; it is not in the top bar. */}
  {
    moreCount > 0 && (
      <p class="projects-more" data-reveal>
        <a class="button button-quiet" href="/projects">
          View more projects
        </a>
      </p>
    )
  }
</section>
