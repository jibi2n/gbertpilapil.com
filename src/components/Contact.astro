---
import { site } from '../site';
import Icon from './Icon.astro';

const linkIcon = (label: string) => label.toLowerCase() as 'linkedin' | 'github' | 'facebook' | 'instagram';
---

<section id="contact" class="section">
  <h2 class="display heading section-head" data-reveal>Get in touch</h2>
  <p class="prose mb-6" data-reveal>
    I'm open to software engineering, data and AI work. Please contact me soon :>
  </p>
  <div data-reveal>
    <p class="contact-email-row">
      <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
      <button type="button" class="contact-copy" data-copy={site.email} aria-label="Copy email address">
        <Icon name="copy" />
        <span class="copied-label" aria-hidden="true">Copied</span>
      </button>
    </p>
    <ul class="contact-links" aria-label="Elsewhere">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} aria-label={link.label} title={link.label}>
              <Icon name={linkIcon(link.label)} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
