---
import { site } from '../site';
---

<section id="contact" class="section">
  <h2 class="display heading section-head" data-reveal>Get in touch</h2>
  <p class="prose mb-6" data-reveal>
    I'm open to software engineering, data and AI work. Email is the fastest way to reach me.
  </p>
  <a class="contact-email" href={`mailto:${site.email}`} data-reveal>{site.email}</a>
  <ul class="contact-links">
    {
      site.links.map((link) => (
        <li>
          <a class="link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
