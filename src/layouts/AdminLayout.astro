---
// Page frame for the private dashboard. Every page that uses it lives under
// /admin, which src/middleware.ts locks to the signed-in admin.
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="professional">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Dashboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Same light/dark choice as the public site. -->
    <script is:inline>
      (function () {
        var mode = null;
        try {
          mode = localStorage.getItem('mode');
        } catch (e) {}
        if (mode !== 'dark' && mode !== 'light') {
          mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.mode = mode;
      })();
    </script>
  </head>
  <body>
    <header class="admin-bar">
      <a href="/admin" class="admin-home">Dashboard</a>
      <span class="small">Signed in as {Astro.locals.adminEmail}</span>
      <a href="/" class="link">View the site</a>
    </header>
    <main class="admin">
      <slot />
    </main>
  </body>
</html>
