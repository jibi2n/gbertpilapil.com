---
import '../styles/global.css';
import Decor from '../components/Decor.astro';
import Mascot from '../components/Mascot.astro';
import Nav from '../components/Nav.astro';
import { site } from '../site';
import { themes } from '../themes';

interface Props {
  /** Browser tab title. Defaults to the site title. */
  title?: string;
}

const { title = site.title } = Astro.props;
const themeIds = themes.map((theme) => theme.id);
---

<!doctype html>
<html lang="en" data-theme={themeIds[0]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Runs before first paint: restores the saved theme so there is no flash,
         and decides whether to show the loading screen and animations. -->
    <script is:inline define:vars={{ themeIds }}>
      (function () {
        var root = document.documentElement;
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var theme = themeIds.indexOf(saved) >= 0 ? saved : themeIds[0];
        root.dataset.theme = theme;
        // The extra themes are hidden until found. Anyone already on one has found them.
        var unlocked = null;
        try {
          unlocked = localStorage.getItem('themes-unlocked');
        } catch (e) {}
        if (unlocked === '1' || (theme !== 'summary' && theme !== 'professional')) {
          root.classList.add('themes-unlocked');
        }
        // Light or dark: the visitor's last choice, else light.
        var mode = null;
        try {
          mode = localStorage.getItem('mode');
        } catch (e) {}
        root.dataset.mode = mode === 'dark' ? 'dark' : 'light';
        root.classList.add('js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        try {
          if (!sessionStorage.getItem('visited')) {
            sessionStorage.setItem('visited', '1');
            // The resume view should appear instantly, with no loading screen in front of it.
            if (theme !== 'summary') root.classList.add('is-loading');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-themes={JSON.stringify(themes)}>
    <div class="loader" aria-hidden="true">
      <span class="display subheading">{site.name}</span>
      <span class="loader-bar"></span>
    </div>
    <Decor />
    <Nav />
    <main id="top">
      <slot />
    </main>
    <Mascot />
    <footer class="footer small">
      <a href="#top" class="footer-top">
        <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7M12 19V5" /></svg>
        Back to top
      </a>
      {/* Reveals the hidden themes; once they're found it steps through them. */}
      <button type="button" class="egg">
        <span class="egg-locked">Explore this site in other themes</span>
        <span class="egg-unlocked">Try another theme</span>
      </button>
      <span>{site.location}</span>
    </footer>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
