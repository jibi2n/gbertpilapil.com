---
// Every project marked for listing, not just the showcased ones.
// Reached from "View more projects" in the home page's Projects section.
import { env } from 'cloudflare:workers';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectPanels from '../components/ProjectPanels.astro';
import Layout from '../layouts/Layout.astro';
import type { Project } from '../lib/models/Project';
import { ProjectRepository } from '../lib/repositories/ProjectRepository';
import { site } from '../site';

// Rendered on each request so dashboard edits show up straight away.
export const prerender = false;

let projects: Project[] = [];
let emptyMessage = 'No projects to show yet.';
try {
  projects = await new ProjectRepository(env.DB).listListed();
} catch (error) {
  console.error('Could not load projects from D1', error);
  emptyMessage = "The projects couldn't load. Refresh the page to try again.";
}

/** The distinct values across all projects, most used first. */
function ranked(pick: (project: Project) => readonly string[]) {
  const counts = new Map<string, number>();
  for (const project of projects) {
    for (const name of pick(project)) counts.set(name, (counts.get(name) ?? 0) + 1);
  }
  return [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([name]) => name);
}

// The main filter is by specialization; technology is a second, optional one.
const specializations = ranked((project) => project.specializations);
const technologies = ranked((project) => project.technologies);
---

<Layout title={`Projects | ${site.name}`}>
  <section class="section page">
    <p class="mb-6"><a class="link" href="/#projects">Back to the home page</a></p>
    <h1 class="display heading section-head">All projects</h1>

    {
      specializations.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by specialization">
          <button type="button" class="chip filter" data-filter-kind="spec" data-filter="" aria-pressed="true">
            All
          </button>
          {specializations.map((name) => (
            <button type="button" class="chip filter" data-filter-kind="spec" data-filter={name} aria-pressed="false">
              {name}
            </button>
          ))}
        </div>
      )
    }

    {
      technologies.length > 1 && (
        <details class="filter-more">
          <summary class="link">Filter by technology</summary>
          <div class="filters filters-small" role="group" aria-label="Filter by technology">
            <button type="button" class="chip filter" data-filter-kind="tech" data-filter="" aria-pressed="true">
              Any
            </button>
            {technologies.map((name) => (
              <button type="button" class="chip filter" data-filter-kind="tech" data-filter={name} aria-pressed="false">
                {name}
              </button>
            ))}
          </div>
        </details>
      )
    }

    {projects.length === 0 && <p class="small">{emptyMessage}</p>}
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="small filter-empty" hidden>No projects match that combination. Try a different filter.</p>
  </section>

  <ProjectPanels projects={projects} />

  <script>
    // Two filters that work together: a project shows when it matches the
    // chosen specialization and the chosen technology.
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...document.querySelectorAll<HTMLElement>('.project')];
    const empty = document.querySelector<HTMLElement>('.filter-empty');
    const chosen: Record<string, string> = { spec: '', tech: '' };

    const has = (list: string | undefined, wanted: string) => wanted === '' || (list ?? '').split('|').includes(wanted);

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const kind = button.dataset.filterKind!;
        chosen[kind] = button.dataset.filter ?? '';
        for (const other of buttons) {
          if (other.dataset.filterKind === kind) other.setAttribute('aria-pressed', String(other === button));
        }
        let shown = 0;
        for (const card of cards) {
          const match = has(card.dataset.spec, chosen.spec) && has(card.dataset.tech, chosen.tech);
          card.hidden = !match;
          if (match) shown++;
        }
        if (empty) empty.hidden = shown > 0;
      });
    }
  </script>
</Layout>
