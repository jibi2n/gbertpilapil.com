---
// Every project marked for listing, not just the showcased ones.
// Reached from "View more projects" in the home page's Projects section.
import { env } from 'cloudflare:workers';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectPanels from '../components/ProjectPanels.astro';
import TechLogo from '../components/TechLogo.astro';
import Layout from '../layouts/Layout.astro';
import type { Project } from '../lib/models/Project';
import { ProjectRepository } from '../lib/repositories/ProjectRepository';
import { site } from '../site';

// Rendered on each request so dashboard edits show up straight away.
export const prerender = false;

let projects: Project[] = [];
let emptyMessage = 'No projects to show yet.';
try {
  projects = await new ProjectRepository(env.DB).listListed();
} catch (error) {
  console.error('Could not load projects from D1', error);
  emptyMessage = "The projects couldn't load. Refresh the page to try again.";
}

/** The distinct values across all projects, most used first. */
function ranked(pick: (project: Project) => readonly string[]) {
  const counts = new Map<string, number>();
  for (const project of projects) {
    for (const name of pick(project)) counts.set(name, (counts.get(name) ?? 0) + 1);
  }
  return [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([name]) => name);
}

// The main filter is by specialization; technology is a second, optional one.
const specializations = ranked((project) => project.specializations);
const technologies = ranked((project) => project.technologies);
---

<Layout title={`Projects | ${site.name}`}>
  <section class="section page">
    <p class="page-back">
      <a href="/#projects">
        <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7" /></svg>
        Home
      </a>
    </p>
    <div class="page-head">
      <div class="page-title">
        <h1 class="display heading">All projects</h1>
        <p class="small" aria-live="polite" data-filter-count>
          {projects.length} {projects.length === 1 ? 'project' : 'projects'}
        </p>
      </div>
      {
        projects.length > 1 && (
          <button type="button" class="chip filter-toggle" popovertarget="filter-panel" data-filter-toggle>
            <svg class="icon icon-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M6 12h12M10 18h4" /></svg>
            Filter
            <span class="filter-badge" data-filter-badge hidden></span>
          </button>
        )
      }
    </div>

    {/* The filters in use, each removable. Filled in by the script below. */}
    <div class="active-filters" data-active-filters hidden></div>

    {/* One field and one technology at most; tapping a chosen one again clears it. */}
    <div id="filter-panel" class="filter-panel" popover data-lenis-prevent>
      <input type="search" class="filter-search" placeholder="Search fields and technologies" aria-label="Search filters" data-filter-search />
      {
        [
          { kind: 'spec', label: 'Field', names: specializations },
          { kind: 'tech', label: 'Technology', names: technologies },
        ].map((group) => (
          <section class="filter-group" data-filter-group>
            <h2 class="filter-group-label">{group.label}</h2>
            <div class="filter-options">
              {group.names.map((name) => (
                <button type="button" class="chip filter" data-kind={group.kind} data-filter={name} aria-pressed="false">
                  {group.kind === 'tech' && <TechLogo name={name} />}
                  {name}
                </button>
              ))}
            </div>
          </section>
        ))
      }
      <p class="small" data-filter-nomatch hidden>No filters match that search.</p>
      <div class="filter-panel-foot">
        <button type="button" class="link" data-filter-clear>Clear</button>
        <button type="button" class="button" popovertarget="filter-panel" popovertargetaction="hide" data-filter-show>
          Show {projects.length} projects
        </button>
      </div>
    </div>

    {projects.length === 0 && <p class="small">{emptyMessage}</p>}
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="small filter-empty" hidden>No projects match that combination. Try a different filter.</p>
  </section>

  <ProjectPanels projects={projects} />

  <script>
    // Two filters that work together: a project shows when it matches the
    // chosen field and the chosen technology. One of each at most.
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...document.querySelectorAll<HTMLElement>('.project')];
    const empty = document.querySelector<HTMLElement>('.filter-empty');
    const count = document.querySelector<HTMLElement>('[data-filter-count]');
    const badge = document.querySelector<HTMLElement>('[data-filter-badge]');
    const showButton = document.querySelector<HTMLElement>('[data-filter-show]');
    const activeRow = document.querySelector<HTMLElement>('[data-active-filters]')!;
    const chosen: Record<string, string> = { spec: '', tech: '' };

    const has = (list: string | undefined, wanted: string) => wanted === '' || (list ?? '').split('|').includes(wanted);
    const plural = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;

    function update() {
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chosen[chip.dataset.kind!] === chip.dataset.filter));
      }
      let shown = 0;
      for (const card of cards) {
        const match = has(card.dataset.spec, chosen.spec) && has(card.dataset.tech, chosen.tech);
        card.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = plural(shown);
      if (showButton) showButton.textContent = `Show ${plural(shown)}`;

      // The chips under the title, one per filter in use, plus "Clear all".
      const inUse = Object.entries(chosen).filter(([, value]) => value);
      if (badge) {
        badge.hidden = inUse.length === 0;
        badge.textContent = String(inUse.length);
      }
      activeRow.hidden = inUse.length === 0;
      const items: HTMLElement[] = inUse.map(([kind, value]) => {
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'chip active-filter';
        remove.setAttribute('aria-label', `Remove filter: ${value}`);
        remove.textContent = `${value} ×`;
        remove.addEventListener('click', () => {
          chosen[kind] = '';
          update();
        });
        return remove;
      });
      if (inUse.length > 0) {
        const clearAll = document.createElement('button');
        clearAll.type = 'button';
        clearAll.className = 'link';
        clearAll.textContent = 'Clear all';
        clearAll.addEventListener('click', clear);
        items.push(clearAll);
      }
      activeRow.replaceChildren(...items);
    }

    function clear() {
      chosen.spec = '';
      chosen.tech = '';
      update();
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const kind = chip.dataset.kind!;
        chosen[kind] = chosen[kind] === chip.dataset.filter ? '' : chip.dataset.filter!;
        update();
      });
    }
    document.querySelector('[data-filter-clear]')?.addEventListener('click', clear);

    // Search narrows the chips in both groups.
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    const groups = [...document.querySelectorAll<HTMLElement>('[data-filter-group]')];
    const noMatch = document.querySelector<HTMLElement>('[data-filter-nomatch]');
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      for (const chip of chips) chip.hidden = !chip.dataset.filter!.toLowerCase().includes(query);
      for (const group of groups) group.hidden = !group.querySelector('.filter:not([hidden])');
      if (noMatch) noMatch.hidden = groups.some((group) => !group.hidden);
    });

    // The dropdown opens under the Filter button, lined up with its right edge.
    const panel = document.querySelector<HTMLElement>('#filter-panel');
    const toggle = document.querySelector<HTMLElement>('[data-filter-toggle]');
    panel?.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState !== 'open' || !toggle) return;
      const box = toggle.getBoundingClientRect();
      panel.style.top = `${box.bottom + window.scrollY + 8}px`;
      panel.style.right = `${document.documentElement.clientWidth - box.right}px`;
      if (matchMedia('(hover: hover)').matches) search?.focus();
    });
  </script>
</Layout>
