---
// Every project marked for listing, not just the showcased ones.
// Reached from "View more projects" in the home page's Projects section.
import { env } from 'cloudflare:workers';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectPanels from '../components/ProjectPanels.astro';
import Layout from '../layouts/Layout.astro';
import type { Project } from '../lib/models/Project';
import { ProjectRepository } from '../lib/repositories/ProjectRepository';
import { site } from '../site';

// Rendered on each request so dashboard edits show up straight away.
export const prerender = false;

let projects: Project[] = [];
let emptyMessage = 'No projects to show yet.';
try {
  projects = await new ProjectRepository(env.DB).listListed();
} catch (error) {
  console.error('Could not load projects from D1', error);
  emptyMessage = "The projects couldn't load. Refresh the page to try again.";
}

// Filter buttons: each technology used by at least one project, most used first.
const counts = new Map<string, number>();
for (const project of projects) {
  for (const name of project.technologies) counts.set(name, (counts.get(name) ?? 0) + 1);
}
const technologies = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([name]) => name);
---

<Layout title={`Projects | ${site.name}`}>
  <section class="section page">
    <p class="mb-6"><a class="link" href="/#projects">Back to the home page</a></p>
    <h1 class="display heading section-head">All projects</h1>

    {
      technologies.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by technology">
          <button type="button" class="chip filter" data-filter="" aria-pressed="true">
            All
          </button>
          {technologies.map((name) => (
            <button type="button" class="chip filter" data-filter={name} aria-pressed="false">
              {name}
            </button>
          ))}
        </div>
      )
    }

    {projects.length === 0 && <p class="small">{emptyMessage}</p>}
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="small filter-empty" hidden>No projects use that yet.</p>
  </section>

  <ProjectPanels projects={projects} />

  <script>
    // Technology filter: show only the projects built with the chosen one.
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...document.querySelectorAll<HTMLElement>('.project')];
    const empty = document.querySelector<HTMLElement>('.filter-empty');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const wanted = button.dataset.filter ?? '';
        let shown = 0;
        for (const card of cards) {
          const match = wanted === '' || (card.dataset.tech ?? '').split('|').includes(wanted);
          card.hidden = !match;
          if (match) shown++;
        }
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
        if (empty) empty.hidden = shown > 0;
      });
    }
  </script>
</Layout>
