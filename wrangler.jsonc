{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "gbert-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Keep the workers.dev address working alongside the real domain.
	"workers_dev": true,
	"routes": [
		{ "pattern": "gbertpilapil.com", "custom_domain": true },
		{ "pattern": "www.gbertpilapil.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gbert-portfolio",
			"database_id": "0f37eef0-8c7b-4250-b875-fbf56493d42d",
			"migrations_dir": "migrations"
		}
	],
	// Who may open the dashboard at /admin. The first two come from the Cloudflare
	// Access application guarding it; while they are empty the dashboard stays locked.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "restless-cake-2d95.cloudflareaccess.com",
		"ACCESS_AUD": "5323d09be3133d6973eb13b114b70a72fb6c700e31af9f07b7883fe7a955299e",
		"ADMIN_EMAIL": "gbertpilapil12@gmail.com"
	},
	// Holds the resume PDF and uploaded project pictures, so they can be replaced without a redeploy.
	"kv_namespaces": [
		{
			"binding": "FILES",
			"id": "07f6b9c93b8c43d78d196727156da034"
		}
	],
	"observability": {
		"enabled": true
	}
}
