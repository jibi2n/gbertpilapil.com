{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "gbert-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Keep the workers.dev address working alongside the real domain.
	"workers_dev": true,
	"routes": [
		{ "pattern": "gbertpilapil.com", "custom_domain": true },
		{ "pattern": "www.gbertpilapil.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gbert-portfolio",
			"database_id": "0f37eef0-8c7b-4250-b875-fbf56493d42d",
			"migrations_dir": "migrations"
		}
	],
	// Holds the resume PDF so it can be replaced without a redeploy.
	"kv_namespaces": [
		{
			"binding": "FILES",
			"id": "07f6b9c93b8c43d78d196727156da034"
		}
	],
	"observability": {
		"enabled": true
	}
}
